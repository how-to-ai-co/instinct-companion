# Public demo is the default. Never connect personal credentials to the public demo.
NEXT_PUBLIC_DEMO_MODE=true
# Self-hosted installations only: set false and supply your own credentials.
COMPANION_PASSWORD=
COMPANION_SESSION_SECRET=
COMPANION_INGEST_TOKEN=
