# Each installation must use its OWN Supabase project. Never use NEXT_PUBLIC_ for these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a unique random integration key (at least 32 characters).
COMPANION_INGEST_TOKEN=
# true exposes all saved records and messages to visitors. Only enable for public/non-sensitive data.
# For a private copy, use deployment access protection or implement viewer authentication.
COMPANION_PUBLIC_READ=false
